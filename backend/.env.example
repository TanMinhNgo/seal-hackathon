APP_NAME=SEAL API
DATABASE_URL=postgresql+asyncpg://seal:seal_dev@127.0.0.1:5434/seal
REDIS_URL=redis://127.0.0.1:6379/0
# Sinh secret local: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=starttls
SMTP_FROM=noreply@seal.example
GITHUB_TOKEN=
# Bật AI ở Event trước khi vòng bắt đầu; code đã lọc sẽ gửi OpenAI.
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini-2024-07-18
# Cloudinary product environment dev/test riêng, authenticated raw assets.
# API_SECRET chỉ ở backend; không dùng unsigned upload preset cho bài nộp.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLI vận hành: export trong shell (không chỉ ghi trong .env); xem deploy/README.md.
# SEAL_LOAD_ALLOWED_ORIGINS=https://staging.example.com
# SEAL_RESTORE_ROOT=/isolated
