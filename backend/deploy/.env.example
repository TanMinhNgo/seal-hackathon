SEAL_STACK=seal-staging
SEAL_IMAGE=seal-backend:staging
DOMAIN=staging.example.com
FRONTEND_UPSTREAM=http://host.docker.internal:3000
POSTGRES_PASSWORD=replace-with-random-password
# URL-encode password nếu có ký tự đặc biệt; hostname là service compose.
DATABASE_URL=postgresql+asyncpg://seal:replace-with-random-password@postgres:5432/seal
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-at-least-32-random-bytes
FRONTEND_URL=https://staging.example.com
CORS_ORIGINS=["https://staging.example.com"]
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=starttls
SMTP_FROM=noreply@example.com
GITHUB_TOKEN=
OPENAI_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Chỉ public key age trên server; private key giữ offline.
BACKUP_AGE_RECIPIENT=
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
